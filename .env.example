# Variables de entorno — PicaditoYa (Plantilla)
# Copiá este archivo como .env y completá los valores

# ─────────────────────────────────────────────
# BASE DE DATOS — Supabase
# ─────────────────────────────────────────────
# Puerto 6543 = Pooler Transaction mode — para queries en runtime
DATABASE_URL="postgresql://postgres.USER:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Puerto 5432 = Session mode — solo para migraciones (prisma migrate dev)
DIRECT_URL="postgresql://postgres.USER:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────
# NEXTAUTH (Auth.js v5)
# ─────────────────────────────────────────────
# Generá un secret con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secret-muy-largo-y-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
# En producción: NEXTAUTH_URL="https://tu-dominio.vercel.app"

# ─────────────────────────────────────────────
# MAPTILER
# ─────────────────────────────────────────────
# API Key pública de MapTiler (creala en https://cloud.maptiler.com/account/keys/)
# Puede exponerse en el frontend
NEXT_PUBLIC_MAPTILER_KEY="COMPLETAR"

# ─────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# SUPABASE — API (para Edge Functions)
# ─────────────────────────────────────────────
# URL del proyecto Supabase (visible en Dashboard > Settings > API)
SUPABASE_URL="https://TU-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROJECT-REF.supabase.co"

# Service Role Key — NUNCA exponer al cliente ni como NEXT_PUBLIC_
# Solo para uso en el backend de Next.js (API Routes, Server Actions)
# La encontrás en Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY="COMPLETAR"

# ─────────────────────────────────────────────
# WEB PUSH — VAPID
# ─────────────────────────────────────────────
# Clave pública VAPID — SEGURA para exponer al frontend (NEXT_PUBLIC_)
# Generá el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="COMPLETAR"

# Clave privada VAPID — NUNCA exponer al frontend ni como NEXT_PUBLIC_
# Solo debe estar en:
#   1. Este archivo .env (para desarrollo local)
#   2. Los Secrets de Supabase Edge Functions (para producción)
# NUNCA agregar esta variable al repositorio con un valor real.
VAPID_PRIVATE_KEY="COMPLETAR"

# Email o URL del servidor — aparece en el JWT de autenticación VAPID
# Reemplazá con tu email real o la URL de tu app
VAPID_SUBJECT="mailto:soporte@picaditoya.com"

# ─────────────────────────────────────────────
# API INTERNA — Seguridad
# ─────────────────────────────────────────────
# Secret para llamadas internas entre servicios del backend
# Generá con: openssl rand -base64 32
INTERNAL_API_SECRET="COMPLETAR"

